{
	"name": "yuque-sync",
	"version": "1.1.0",
	"description": "在 Obsidian 与语雀之间同步 Markdown 文档",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"check": "npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"yuque",
		"sync",
		"markdown"
	],
	"author": "weepwood",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
