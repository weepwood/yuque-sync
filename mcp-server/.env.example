# ---------- Yuque ----------
YUQUE_TOKEN=replace_with_yuque_personal_token
YUQUE_COOKIE=replace_with_full_cookie_header_value
YUQUE_REPO=weepwood/ai-image
YUQUE_BASE_URL=https://www.yuque.com
YUQUE_UPLOAD_PATH=/api/upload/attach

# ---------- MCP HTTP server ----------
HOST=127.0.0.1
PORT=8787
MCP_PATH=/mcp
MCP_BEARER_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=

# ---------- Limits and behavior ----------
MAX_IMAGE_MB=25
MAX_BATCH_IMAGES=10
REQUEST_TIMEOUT_MS=60000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
DOCUMENT_TIMEZONE=Asia/Tokyo
LOG_LEVEL=info
DOWNLOAD_ALLOWED_HOSTS=
