{
  "name": "yuque-image-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "A remote and stdio MCP server that uploads images to Yuque and creates image archive documents for ChatGPT.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "dev:stdio": "tsx watch src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/http.js",
    "start:stdio": "node dist/src/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0-beta.4",
    "@modelcontextprotocol/node": "2.0.0-beta.4",
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
